    "dotenv": "^18.0.7",
    "effect": "4.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "prisma": "8.0.0-rc.33"
  },
  "overrides": {
